# Project documentation sources (excluded from build)
^README\.Rmd$
^README\.html$
^NEWS\.Rmd$
^cran-comments\.md$
^CLAUDE\.md$
^CRAN-RELEASE$

# RStudio-specific files and settings
^.*\.Rproj$
^\.Rproj\.user$
^\.Rhistory$
^\.Renviron$

# Development-only directories and files
^data-raw$
^revdep$

# Git and GitHub configuration files
^\.gitignore$
^\.github$
^\.positai$
^\.claude($|/)
^TODO\.md$
^check_result\.log$
^CRAN-SUBMISSION$
^doc$
^Meta$

# pkgdown configuration and build output (rendered by pkgdown::build_site(), not devtools::build_vignettes())
^_pkgdown\.yml$
^docs$
^vignettes/articles$
^\.claude$
